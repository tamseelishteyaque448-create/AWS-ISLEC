# Copy to .env.local and fill in the values from your Supabase project's Connect dialog.
#
# Placeholders only. Never commit a real project reference or a real key here:
# a fresh `cp .env.example .env.local` must never point at someone's live database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_publishable_key

# Server-only. Add the real sb_secret_ value locally and in Vercel; never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_only_key

# Absolute origin used for invitation and auth redirects. Required at runtime.
APP_URL=http://localhost:3000