{
  "name": "aws-islec",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:qa": "node scripts/dev-qa.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components data lib proxy.ts --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "types:check": "node scripts/check-database-types.mjs --local",
    "types:check:linked": "node scripts/check-database-types.mjs --linked",
    "types:write": "node scripts/check-database-types.mjs --local --write",
    "test:unit": "node --test tests/unit/disposable-e2e-env.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:disposable": "node scripts/run-disposable-e2e.mjs",
    "test:e2e:disposable:guard": "node --test tests/unit/disposable-e2e-env.test.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "supabase:db:lint": "supabase db lint --local"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "latest",
    "supabase": "^2.119.0",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}