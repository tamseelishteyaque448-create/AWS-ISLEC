# Copy this file to .env.qa.local and fill it with the separate AWS-ISLEC-QA values.
# Never use the production Supabase URL in this file.
NEXT_PUBLIC_SUPABASE_URL=https://<aws-islec-qa-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<qa-publishable-key>
SUPABASE_SECRET_KEY=<qa-secret-key>
APP_URL=http://localhost:3000
